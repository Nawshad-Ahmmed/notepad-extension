{
  "manifest_version": 3,
  "name": "Notepad",
  "version": "1.2.0",
  "description": "A fast, offline notepad in your browser. Optional AES-GCM encryption at rest, multiple notes, autosave, search, export.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Notepad",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Open Notepad"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}